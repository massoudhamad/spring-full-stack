# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

DB_URL=jdbc:postgresql://localhost:5432/pmis
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Test database — create it first:  createdb pmis_test
TEST_DB_URL=jdbc:postgresql://localhost:5432/pmis_test
TEST_DB_USER=your_db_user
TEST_DB_PASSWORD=your_db_password
