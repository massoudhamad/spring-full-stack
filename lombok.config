config.stopBubbling = true

# Marks generated methods so coverage tools do not count them as untested.
lombok.addLombokGeneratedAnnotation = true

# @Data and @Value are BANNED project-wide.
#
# On a JPA entity @Data generates equals/hashCode/toString over every field,
# including lazy associations. toString() then loads the whole object graph,
# and hashCode changes when the id is assigned — so an entity added to a
# HashSet before save becomes unreachable after it.
#
# Use @Getter, @NoArgsConstructor and @Builder explicitly instead.
lombok.data.flagUsage = ERROR
lombok.value.flagUsage = ERROR

# Same reasoning, stated directly.
lombok.equalsAndHashCode.flagUsage = ERROR

# Field injection hides dependencies and cannot be constructed in a test.
lombok.allArgsConstructor.flagUsage = WARNING
