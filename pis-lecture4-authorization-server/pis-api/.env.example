# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

SERVER_PORT=8181

DB_URL=jdbc:postgresql://localhost:5432/pmis_oauth
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Test database — create it first:  createdb pmis_oauth_test
TEST_DB_URL=jdbc:postgresql://localhost:5432/pmis_oauth_test
TEST_DB_USER=your_db_user
TEST_DB_PASSWORD=your_db_password

# The authorization server PIS trusts. No secret needed: PIS only uses its PUBLIC keys.
AUTH_ISSUER=http://localhost:9100
