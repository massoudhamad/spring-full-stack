# Copy to .env:  cp .env.example .env    (.env is gitignored)
SERVER_PORT=9100

# The three PIS users. In production these would live in a database (Lesson 2).
OFFICER_PASSWORD=change-me
APPROVER_PASSWORD=change-me
ADMIN_PASSWORD=change-me

# Confidential clients authenticate to /oauth2/token with these.
# Generate with:  openssl rand -base64 24
PIS_BFF_SECRET=change-me
PIS_REPORTING_SECRET=change-me
