config.stopBubbling = true

# Marks generated methods so coverage tools do not count them as untested.
lombok.addLombokGeneratedAnnotation = true

# @Data is used on entities and DTOs by project decision.
#
# Known trade-offs, accepted deliberately:
#   - equals/hashCode cover every field, including the id JPA assigns on save.
#     An entity put in a HashSet before persist() is unreachable afterwards.
#   - toString() covers every field, so a lazy association is loaded when an
#     entity is logged, and bidirectional links recurse. @ToString(of = {...})
#     is kept on the entities below to contain that.
#   - Setters are generated for every field, so state changes can bypass the
#     named methods that hold the rules.

# Field injection hides dependencies and cannot be constructed in a test.
lombok.allArgsConstructor.flagUsage = WARNING
